{
  "template_id": "badge_round",
  "label": "Round Badge / Button",
  "scad_file": "model.scad",
  "max_lines": 2,
  "text_box": {
    "box_w": "2*(diameter/2 - border_w - pad_x)*0.707",
    "box_h": "2*(diameter/2 - border_w - pad_y)*0.707",
    "offset_x": 0,
    "offset_y": 0
  },
  "params": {
    "diameter": {
      "type": "number",
      "default": 50,
      "min": 20,
      "max": 150,
      "label": "Diameter",
      "group": "Dimensions",
      "help": "Width across the circle.",
      "unit": "mm"
    },
    "th": {
      "type": "number",
      "default": 4.0,
      "min": 1.5,
      "max": 12.0,
      "label": "Thickness",
      "group": "Dimensions",
      "help": "How thick the plate is. 3–4 mm is sturdy for a tag or keychain.",
      "unit": "mm"
    },
    "border_w": {
      "type": "number",
      "default": 4.0,
      "min": 0.0,
      "max": 15.0,
      "label": "Border width",
      "group": "Dimensions",
      "help": "Width of the raised frame around the edge.",
      "unit": "mm"
    },
    "border_th": {
      "type": "number",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0,
      "label": "Border height",
      "group": "Advanced",
      "help": "How far the frame stands proud of the surface.",
      "unit": "mm"
    },
    "bail_enabled": {
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 1,
      "label": "Add hanging loop",
      "group": "Style",
      "help": "1 = add a loop for a chain or keyring, 0 = none."
    },
    "bail_d": {
      "type": "number",
      "default": 6.0,
      "min": 3.0,
      "max": 15.0,
      "label": "Loop diameter",
      "group": "Style",
      "help": "Size of the hanging loop.",
      "unit": "mm"
    },
    "bail_thick": {
      "type": "number",
      "default": 2.0,
      "min": 1.0,
      "max": 5.0,
      "label": "Loop thickness",
      "group": "Advanced",
      "help": "How chunky the loop is.",
      "unit": "mm"
    },
    "line1": {
      "type": "string",
      "default": "YOUR TEXT",
      "label": "Line 1",
      "group": "Text",
      "help": "The main line of text."
    },
    "line2": {
      "type": "string",
      "default": "",
      "label": "Line 2",
      "group": "Text",
      "help": "A second line. Leave blank for one line."
    },
    "text_size": {
      "type": "number",
      "default": 10,
      "min": 4,
      "max": 30,
      "label": "Max text size",
      "group": "Text",
      "help": "Cap on letter height. Text is shrunk automatically if it doesn't fit, so this is a maximum, not a fixed size.",
      "unit": "mm"
    },
    "text_height": {
      "type": "number",
      "default": 1.2,
      "min": 0.4,
      "max": 4.0,
      "label": "Text height",
      "group": "Style",
      "help": "How far the letters stick out (or how deep they're cut). About 1 mm is plenty.",
      "unit": "mm"
    },
    "line_gap": {
      "type": "number",
      "default": 8,
      "min": 3,
      "max": 20,
      "label": "Line spacing",
      "group": "Text",
      "help": "Vertical gap between lines. Reduced automatically if the lines won't fit.",
      "unit": "mm"
    },
    "pad_x": {
      "type": "number",
      "default": 4,
      "min": 2,
      "max": 20,
      "label": "Side padding",
      "group": "Advanced",
      "help": "Clear space left and right of the text.",
      "unit": "mm"
    },
    "pad_y": {
      "type": "number",
      "default": 4,
      "min": 2,
      "max": 20,
      "label": "Top/bottom padding",
      "group": "Advanced",
      "help": "Clear space above and below the text.",
      "unit": "mm"
    },
    "text_align": {
      "type": "string",
      "default": "center",
      "options": [
        "left",
        "center",
        "right"
      ],
      "label": "Text alignment",
      "group": "Style",
      "help": "Left, centred, or right."
    },
    "emboss": {
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 1,
      "label": "Raised text",
      "group": "Style",
      "help": "1 = text sticks out of the surface, 0 = text is cut into it. Raised text is easier to print and to colour differently."
    },
    "offset_x": {
      "type": "number",
      "default": 0,
      "min": -100,
      "max": 100,
      "hidden": true
    },
    "offset_y": {
      "type": "number",
      "default": 0,
      "min": -100,
      "max": 100,
      "hidden": true
    },
    "text_box_w": {
      "type": "number",
      "default": 30,
      "min": 0,
      "max": 200,
      "hidden": true
    },
    "text_box_h": {
      "type": "number",
      "default": 30,
      "min": 0,
      "max": 200,
      "hidden": true
    },
    "text_box_offset_x": {
      "type": "number",
      "default": 0,
      "min": -100,
      "max": 100,
      "hidden": true
    },
    "text_box_offset_y": {
      "type": "number",
      "default": 0,
      "min": -100,
      "max": 100,
      "hidden": true
    },
    "emblem_enabled": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 1,
      "hidden": true
    },
    "emblem_path": {
      "type": "string",
      "default": "",
      "hidden": true
    },
    "emblem_kind": {
      "type": "string",
      "default": "svg",
      "hidden": true
    },
    "emblem_scale": {
      "type": "number",
      "default": 0.25,
      "min": 0.05,
      "max": 5,
      "label": "Emblem size",
      "group": "Emblem",
      "help": "Scale factor for the uploaded SVG. 0.25 = quarter size."
    },
    "emblem_x": {
      "type": "number",
      "default": 0,
      "min": -75,
      "max": 75,
      "label": "Emblem X",
      "group": "Emblem",
      "help": "Left/right position. Only used when Emblem position is 'custom'.",
      "unit": "mm"
    },
    "emblem_y": {
      "type": "number",
      "default": 0,
      "min": -75,
      "max": 75,
      "label": "Emblem Y",
      "group": "Emblem",
      "help": "Up/down position. Only used when Emblem position is 'custom'.",
      "unit": "mm"
    },
    "emblem_rot": {
      "type": "number",
      "default": 0,
      "min": -180,
      "max": 180,
      "label": "Emblem rotation",
      "group": "Emblem",
      "help": "Turn the emblem.",
      "unit": "°"
    },
    "emblem_mode": {
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 1,
      "hidden": true,
      "label": "Raised emblem",
      "group": "Emblem",
      "help": "1 = emblem sticks out, 0 = it's cut into the surface."
    },
    "emblem_depth": {
      "type": "number",
      "default": 1.2,
      "min": 0.4,
      "max": 4,
      "label": "Emblem height",
      "group": "Emblem",
      "help": "How far the emblem stands out of (or cuts into) the surface.",
      "unit": "mm"
    },
    "emblem_snap": {
      "type": "string",
      "default": "custom",
      "hidden": true,
      "label": "Emblem position",
      "group": "Emblem",
      "help": "Snap the emblem to a spot on the plate. Choose 'custom' to place it by hand with the X/Y values below."
    },
    "emblem_autocenter": {
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 1,
      "hidden": true,
      "label": "Auto-centre emblem",
      "group": "Emblem",
      "help": "1 = centre it exactly when position is 'center'."
    },
    "emblem_invert": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 1,
      "hidden": true
    }
  },
  "category": "Text & signs",
  "icon": "🎖️",
  "description": "Round badge or button with text and an optional emblem."
}
