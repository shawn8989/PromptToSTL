{
  "template_id": "lithophane_circle",
  "label": "Round Photo Lithophane",
  "scad_file": "model.scad",
  "accepts_image": true,
  "native_litho": "circle",
  "category": "Photo gifts",
  "icon": "🌕",
  "description": "Classic circular backlit photo plate. Builds in seconds.",
  "params": {
    "photo_path": { "type": "string", "default": "", "hidden": true },
    "photo_cols": { "type": "integer", "default": 200, "min": 50, "max": 1024, "hidden": true },
    "photo_rows": { "type": "integer", "default": 200, "min": 50, "max": 1024, "hidden": true },
    "diameter": { "type": "number", "default": 80, "min": 30, "max": 200,
                  "label": "Diameter", "unit": "mm", "group": "Dimensions" },
    "frame_width": { "type": "number", "default": 4, "min": 1, "max": 15,
                     "label": "Frame width", "unit": "mm", "group": "Dimensions" },
    "min_thickness": { "type": "number", "default": 0.8, "min": 0.4, "max": 1.5,
                       "label": "Thinnest layer", "unit": "mm", "group": "Advanced",
                       "help": "Brightest image areas. Lower = brighter highlights, but harder to print." },
    "max_thickness": { "type": "number", "default": 3.0, "min": 1.5, "max": 5.0,
                       "label": "Thickest layer", "unit": "mm", "group": "Advanced",
                       "help": "Darkest image areas. Higher = more contrast, longer print." },
    "base_height": { "type": "number", "default": 1.2, "min": 0.4, "max": 3.0,
                     "label": "Base plate height", "unit": "mm", "group": "Advanced" }
