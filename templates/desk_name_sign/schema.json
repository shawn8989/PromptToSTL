{
  "template_id": "desk_name_sign",
  "label": "Desk Name Sign",
  "scad_file": "model.scad",
  "category": "Text & signs",
  "icon": "💼",
  "description": "Wedge-shaped desk sign with your name on the angled face.",
  "max_lines": 2,
  "color_swap_z": "",
  "text_box": {
    "box_w": "w - 16",
    "box_h": "face_h - 10",
    "offset_x": 0,
    "offset_y": 0
  },
  "params": {
    "line1": {
      "type": "string",
      "default": "SHUNATHON OWENS",
      "label": "Line 1",
      "group": "Text",
      "help": "The main line of text."
    },
    "line2": {
      "type": "string",
      "default": "",
      "label": "Line 2",
      "group": "Text",
      "help": "A second line. Leave blank for one line."
    },
    "emboss": {
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 1,
      "label": "Raised text",
      "group": "Style",
      "help": "1 = text sticks out of the surface, 0 = text is cut into it. Raised text is easier to print and to colour differently."
    },
    "w": {
      "type": "number",
      "default": 150,
      "min": 80,
      "max": 250,
      "label": "Width",
      "unit": "mm",
      "group": "Dimensions",
      "help": "Overall width."
    },
    "sign_h": {
      "type": "number",
      "default": 40,
      "min": 25,
      "max": 80,
      "label": "Sign height",
      "unit": "mm",
      "group": "Dimensions",
      "help": "How tall the sign stands."
    },
    "depth": {
      "type": "number",
      "default": 34,
      "min": 20,
      "max": 60,
      "label": "Depth",
      "unit": "mm",
      "group": "Dimensions",
      "help": "Front-to-back depth of the base."
    },
    "face_h": {
      "type": "number",
      "default": 48,
      "min": 20,
      "max": 100,
      "hidden": true
    },
    "text_size": {
      "type": "number",
      "default": 16,
      "min": 6,
      "max": 40,
      "label": "Max text size",
      "unit": "mm",
      "group": "Text",
      "help": "Cap on letter height. Text is shrunk automatically if it doesn't fit, so this is a maximum, not a fixed size."
    },
    "line_gap": {
      "type": "number",
      "default": 14,
      "min": 6,
      "max": 30,
      "label": "Line spacing",
      "unit": "mm",
      "group": "Text",
      "help": "Vertical gap between lines. Reduced automatically if the lines won't fit."
    },
    "text_height": {
      "type": "number",
      "default": 1.5,
      "min": 0.6,
      "max": 3,
      "label": "Text height",
      "unit": "mm",
      "group": "Style",
      "help": "How far the letters stick out (or how deep they're cut). About 1 mm is plenty."
    }
  },
  "multipart": true,
  "thumb_yaw": 145.0
}
