{
  "template_id": "lithophane_mom",
  "label": "MOM Photo Plaque",
  "scad_file": "model.scad",
  "accepts_image": true,
  "category": "Photo gifts",
  "icon": "💐",
  "description": "M ❤ M — your photo as the heart. Mother's Day one-piece plaque.",
  "params": {
    "photo_path": {
      "type": "string",
      "default": "",
      "hidden": true
    },
    "photo_cols": {
      "type": "integer",
      "default": 200,
      "min": 50,
      "max": 1024,
      "hidden": true
    },
    "photo_rows": {
      "type": "integer",
      "default": 200,
      "min": 50,
      "max": 1024,
      "hidden": true
    },
    "heart_w": {
      "type": "number",
      "default": 38,
      "min": 20,
      "max": 80,
      "label": "Heart width",
      "unit": "mm",
      "group": "Dimensions",
      "help": "Width of the heart."
    },
    "heart_h": {
      "type": "number",
      "default": 44,
      "min": 20,
      "max": 80,
      "label": "Heart height",
      "unit": "mm",
      "group": "Dimensions",
      "help": "Height of the heart."
    },
    "letter_section_w": {
      "type": "number",
      "default": 28,
      "min": 15,
      "max": 60,
      "label": "Letter panel width",
      "unit": "mm",
      "group": "Dimensions",
      "help": "Width of each letter panel beside the photo."
    },
    "section_gap": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 10,
      "label": "Panel gap",
      "unit": "mm",
      "group": "Advanced",
      "help": "Spacing between the letter panels and the heart."
    },
    "letter_size": {
      "type": "number",
      "default": 26,
      "min": 10,
      "max": 60,
      "label": "Letter size",
      "unit": "mm",
      "group": "Style",
      "help": "Height of the big letters."
    },
    "letter_height": {
      "type": "number",
      "default": 1.8,
      "min": 0.6,
      "max": 4.0,
      "label": "Letter height",
      "unit": "mm",
      "group": "Style",
      "help": "How far the letters stick out."
    },
    "min_thickness": {
      "type": "number",
      "default": 0.8,
      "min": 0.4,
      "max": 1.5,
      "label": "Thinnest layer",
      "unit": "mm",
      "group": "Advanced",
      "help": "Where the photo is brightest. Thinner = brighter, but below ~0.8 mm it gets fragile."
    },
    "max_thickness": {
      "type": "number",
      "default": 3.0,
      "min": 1.5,
      "max": 5.0,
      "label": "Thickest layer",
      "unit": "mm",
      "group": "Advanced",
      "help": "Where the photo is darkest. Thicker = more contrast, but slower to print."
    },
    "frame_width": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 10,
      "label": "Frame width",
      "unit": "mm",
      "group": "Dimensions",
      "help": "Solid border around the photo. Also what you hold, so don't go below ~3 mm."
    },
    "base_height": {
      "type": "number",
      "default": 1.2,
      "min": 0.4,
      "max": 3.0,
      "label": "Base thickness",
      "unit": "mm",
      "group": "Advanced",
      "help": "Solid backing behind the image. Keep at least 1 mm so the print is strong."
    }
  },
  "color_swap_z": "base_height + max_thickness"
}
