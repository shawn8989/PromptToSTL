{
  "template_id": "lithophane_rectangle",
  "label": "Rectangle Photo Lithophane",
  "scad_file": "model.scad",
  "accepts_image": true,
  "native_litho": "roundrect",
  "category": "Photo gifts",
  "icon": "🖼️",
  "description": "Framed rectangular photo plate with rounded corners. Builds in seconds.",
  "params": {
    "photo_path": {
      "type": "string",
      "default": "",
      "hidden": true
    },
    "photo_cols": {
      "type": "integer",
      "default": 200,
      "min": 50,
      "max": 1024,
      "hidden": true
    },
    "photo_rows": {
      "type": "integer",
      "default": 200,
      "min": 50,
      "max": 1024,
      "hidden": true
    },
    "plate_w": {
      "type": "number",
      "default": 100,
      "min": 30,
      "max": 250,
      "label": "Plate width",
      "unit": "mm",
      "group": "Dimensions",
      "help": "Width of the backing plate."
    },
    "plate_h": {
      "type": "number",
      "default": 75,
      "min": 30,
      "max": 200,
      "label": "Plate height",
      "unit": "mm",
      "group": "Dimensions",
      "help": "Height of the backing plate."
    },
    "frame_width": {
      "type": "number",
      "default": 4,
      "min": 1,
      "max": 15,
      "label": "Frame width",
      "unit": "mm",
      "group": "Dimensions",
      "help": "Solid border around the photo. Also what you hold, so don't go below ~3 mm."
    },
    "corner_r": {
      "type": "number",
      "default": 4,
      "min": 0,
      "max": 20,
      "label": "Corner rounding",
      "unit": "mm",
      "group": "Dimensions",
      "help": "How rounded the corners are. 0 gives sharp corners."
    },
    "min_thickness": {
      "type": "number",
      "default": 0.8,
      "min": 0.4,
      "max": 1.5,
      "label": "Thinnest layer",
      "unit": "mm",
      "group": "Advanced",
      "help": "Where the photo is brightest. Thinner = brighter, but below ~0.8 mm it gets fragile."
    },
    "max_thickness": {
      "type": "number",
      "default": 3.0,
      "min": 1.5,
      "max": 5.0,
      "label": "Thickest layer",
      "unit": "mm",
      "group": "Advanced",
      "help": "Where the photo is darkest. Thicker = more contrast, but slower to print."
    },
    "base_height": {
      "type": "number",
      "default": 1.2,
      "min": 0.4,
      "max": 3.0,
      "label": "Base thickness",
      "unit": "mm",
      "group": "Advanced",
      "help": "Solid backing behind the image. Keep at least 1 mm so the print is strong."
    }
  }
}
