{
  "template_id": "qr_plaque",
  "label": "QR Code Plaque",
  "scad_file": "model.scad",
  "native_litho": "roundrect",
  "qr_input": true,
  "category": "Text & signs",
  "icon": "🔳",
  "description": "Scannable raised-QR plaque from any URL or text — WiFi cards, menus, links.",
  "color_swap_z": "base_height",
  "params": {
    "photo_path": { "type": "string", "default": "", "hidden": true },
    "photo_cols": { "type": "integer", "default": 200, "min": 50, "max": 2048, "hidden": true },
    "photo_rows": { "type": "integer", "default": 200, "min": 50, "max": 2048, "hidden": true },
    "plate_w": { "type": "number", "default": 80, "min": 40, "max": 160, "hidden": true },
    "plate_h": { "type": "number", "default": 80, "min": 40, "max": 160, "hidden": true },
    "qr_text": { "type": "string", "default": "https://example.com",
                 "label": "URL or text", "group": "Text",
                 "help": "What the QR code should open or say when scanned." },
    "size": { "type": "number", "default": 80, "min": 40, "max": 160,
              "label": "Plate size", "unit": "mm", "group": "Dimensions",
              "help": "The plaque is square so the code stays scannable." },
    "frame_width": { "type": "number", "default": 3, "min": 1, "max": 10,
                     "label": "Border width", "unit": "mm", "group": "Dimensions" },
    "corner_r": { "type": "number", "default": 3, "min": 0, "max": 12,
                  "label": "Corner radius", "unit": "mm", "group": "Dimensions" },
    "base_height": { "type": "number", "default": 3, "min": 2, "max": 6,
                     "label": "Plate thickness", "unit": "mm", "group": "Dimensions" },
    "max_thickness": { "type": "number", "default": 0.6, "min": 0.4, "max": 2.0,
                       "label": "QR relief height", "unit": "mm", "group": "Style",
                       "help": "How far the modules stand above the plate. Pause at the plate top and swap filament for a high-contrast, scannable code." },
    "min_thickness": { "type": "number", "default": 0.01, "min": 0.01, "max": 0.01, "hidden": true }
  }
}
