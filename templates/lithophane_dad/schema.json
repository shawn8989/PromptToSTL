    "max_thickness": {
      "type": "number",
      "default": 3.0,
      "min": 1.5,
      "max": 5.0
    },
    "frame_width": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 10
    },
    "base_height": {
      "type": "number",
      "default": 1.2,
      "min": 0.4,
      "max": 3.0
    }
  }
}
