{
  "template_id": "lithophane_dad",
  "label": "Lithophane — DAD (heart centre)",
  "scad_file": "model.scad",
  "accepts_image": true,
  "params": {
    "photo_path": {
      "type": "string",
      "default": "",
      "hidden": true
    },
    "photo_cols": {
      "type": "integer",
      "default": 200,
      "min": 50,
      "max": 1024,
      "hidden": true
    },
    "photo_rows": {
      "type": "integer",
      "default": 200,
      "min": 50,
      "max": 1024,
      "hidden": true
    },
    "heart_w": {
      "type": "number",
      "default": 38,
      "min": 20,
      "max": 80
    },
    "heart_h": {
      "type": "number",
      "default": 44,
      "min": 20,
      "max": 80
    },
    "letter_section_w": {
      "type": "number",
      "default": 28,
      "min": 15,
      "max": 60
    },
    "section_gap": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 10
